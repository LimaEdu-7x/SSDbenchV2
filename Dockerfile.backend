FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    fio util-linux procps ca-certificates curl smartmontools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

# Usa requirements-docker.txt (enxuto, só o necessário para o SSDBench)
COPY backend/requirements-docker.txt /app/backend/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/backend/requirements.txt

COPY backend /app/backend

# Cria diretório padrão para o arquivo de teste
RUN mkdir -p /data && chmod 777 /data

EXPOSE 8001

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]